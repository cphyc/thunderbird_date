{
    "name": "thunderbird_date",
    "version": "0.0.15",
    "description": "Detect dates in emails and create event easily.",
    "main": "background.js",
    "scripts": {
        "bundle": "webpack",
        "webext": "node scripts/build-variants.js all",
        "build": "npm run bundle && npm run webext",
        "build:github": "npm run bundle && node scripts/build-variants.js github",
        "build:thunderbird": "npm run bundle && node scripts/build-variants.js thunderbird",
        "lint": "web-ext lint",
        "test": "mocha"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cphyc/thunderbird_date.git"
    },
    "keywords": [
        "thunderbird",
        "webextension"
    ],
    "author": "Corentin Cadiou",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/cphyc/thunderbird_date/issues"
    },
    "homepage": "https://github.com/cphyc/thunderbird_date#readme",
    "webExt": {
        "sourceDir": "src",
        "ignoreFiles": [
            "change_message.js"
        ]
    },
    "dependencies": {
        "chrono-node": "^2.10.3"
    },
    "devDependencies": {
        "jsdom": "^22.1.0",
        "mocha": "^12.0.3",
        "web-ext": "^10.8.0",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4"
    }
}
