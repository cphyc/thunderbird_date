{
    "name": "thunderbird_date",
    "version": "0.0.16",
    "description": "Detect dates in emails and create event easily.",
    "main": "background.js",
    "scripts": {
        "compile": "tsc -p tsconfig.json && tsc -p tsconfig.runtime.json",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.runtime.json",
        "bundle": "npm run compile && webpack",
        "webext": "node scripts/build-variants.js all",
        "build": "npm run bundle && npm run webext",
        "build:github": "npm run bundle && node scripts/build-variants.js github",
        "build:thunderbird": "npm run bundle && node scripts/build-variants.js thunderbird",
        "lint": "npm run typecheck",
        "test": "npm run typecheck && npm run compile && mocha"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cphyc/thunderbird_date.git"
    },
    "keywords": [
        "thunderbird",
        "webextension"
    ],
    "author": "Corentin Cadiou",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/cphyc/thunderbird_date/issues"
    },
    "homepage": "https://github.com/cphyc/thunderbird_date#readme",
    "dependencies": {
        "chrono-node": "^2.10.3"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "jsdom": "^22.1.0",
        "mocha": "^12.0.3",
        "typescript": "^7.0.2",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4",
        "jszip": "^3.10.2"
    },
    "allowScripts": {
        "core-js@2.6.12": true,
        "core-js@3.6.5": true,
        "spawn-sync@1.0.15": true,
        "dtrace-provider@0.8.8": true
    }
}
