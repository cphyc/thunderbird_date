{
  "manifest_version": 3,
  "name": "Date detector",
  "description": "Detect dates in emails and create event easily.",
  "version": "0.0.15",
  "author": "Corentin Cadiou",
  "browser_specific_settings": {
      "gecko": {
          "id": "data-detection@cphyc.me",
          "strict_min_version": "128.0"
      }
  },
  "permissions": [
    "messagesRead",
    "scripting",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "eventCreator": {
      "schema": "schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "eventCreator"
          ]
        ],
        "script": "implementation.js"
      }
    }
  }
}
